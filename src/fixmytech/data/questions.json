{
  "version": "2026.10.1",
  "settings": {
    "max_questions": 12,
    "min_questions": 3,
    "confident_margin": 3.0,
    "min_utility": 0.4
  },
  "questions": [
    {
      "id": "primary_symptoms",
      "text": "Which problems are you noticing?",
      "help": "Select everything that applies. This decides which follow-up questions are useful.",
      "type": "multi_choice",
      "priority": 100,
      "targets": [
        "software_instability",
        "storage_pressure",
        "battery_wear",
        "charging_path",
        "display_damage",
        "camera_fault",
        "audio_fault",
        "connectivity_issue",
        "liquid_damage"
      ],
      "options": [
        {
          "value": "battery_drain",
          "label": "Battery drains quickly"
        },
        {
          "value": "not_charging",
          "label": "Won't charge, or charges slowly"
        },
        {
          "value": "overheating",
          "label": "Gets unusually hot"
        },
        {
          "value": "shutdowns",
          "label": "Turns off or restarts by itself"
        },
        {
          "value": "slow",
          "label": "Slow or laggy"
        },
        {
          "value": "app_crashes",
          "label": "Apps crash or freeze"
        },
        {
          "value": "screen",
          "label": "Screen cracked, flickering, lines or blank"
        },
        {
          "value": "touch",
          "label": "Touch doesn't respond correctly"
        },
        {
          "value": "camera",
          "label": "Camera problems"
        },
        {
          "value": "audio",
          "label": "Speaker or microphone problems"
        },
        {
          "value": "network",
          "label": "Calls, mobile data or Wi-Fi problems"
        },
        {
          "value": "storage_full",
          "label": "\"Storage full\" warnings"
        },
        {
          "value": "none",
          "label": "No specific problem (general check-up)",
          "exclusive": true
        }
      ]
    },
    {
      "id": "physical_event",
      "text": "Has the phone been dropped or exposed to liquid recently?",
      "type": "single_choice",
      "priority": 90,
      "targets": [
        "display_damage",
        "liquid_damage",
        "camera_fault",
        "audio_fault",
        "charging_path"
      ],
      "options": [
        {
          "value": "none",
          "label": "No"
        },
        {
          "value": "dropped",
          "label": "Dropped / impact"
        },
        {
          "value": "liquid",
          "label": "Liquid exposure (water, drink, rain...)"
        },
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "unsure",
          "label": "Not sure"
        }
      ]
    },
    {
      "id": "battery_swelling",
      "text": "Is the back cover or screen lifting, bulging, or separating at the edges?",
      "help": "A swollen battery can push the screen or back panel outward. This is a safety risk.",
      "type": "single_choice",
      "priority": 70,
      "targets": [
        "battery_wear",
        "display_damage"
      ],
      "visible_if": {
        "any": [
          [
            "ans.primary_symptoms",
            "contains_any",
            [
              "battery_drain",
              "shutdowns",
              "overheating",
              "screen",
              "not_charging"
            ]
          ],
          [
            "obs.battery.status.health",
            "in",
            [
              "dead",
              "overheat",
              "over_voltage",
              "unspecified_failure"
            ]
          ]
        ]
      },
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        },
        {
          "value": "unsure",
          "label": "Not sure"
        }
      ]
    },
    {
      "id": "battery_drain_pattern",
      "text": "How would you describe the battery drain?",
      "type": "single_choice",
      "priority": 60,
      "targets": [
        "battery_wear",
        "software_instability"
      ],
      "visible_if": [
        "ans.primary_symptoms",
        "contains_any",
        [
          "battery_drain",
          "shutdowns"
        ]
      ],
      "options": [
        {
          "value": "fast_always",
          "label": "Much faster than it used to, even when idle"
        },
        {
          "value": "fast_heavy_use",
          "label": "Only during heavy use (games, navigation, camera)"
        },
        {
          "value": "sudden_drops",
          "label": "The percentage drops suddenly (e.g. 30% to 5%)"
        },
        {
          "value": "unsure",
          "label": "Not sure"
        }
      ]
    },
    {
      "id": "shutdown_at_charge",
      "text": "When the phone turns off by itself, how much charge does it show?",
      "type": "single_choice",
      "priority": 60,
      "targets": [
        "battery_wear",
        "software_instability"
      ],
      "visible_if": [
        "ans.primary_symptoms",
        "contains",
        "shutdowns"
      ],
      "options": [
        {
          "value": "yes_above_20",
          "label": "It still shows 20% or more"
        },
        {
          "value": "only_when_low",
          "label": "Only when the battery is nearly empty"
        },
        {
          "value": "only_when_cold",
          "label": "Mostly in cold weather"
        },
        {
          "value": "random_restart",
          "label": "It restarts (reboots) rather than switching off"
        },
        {
          "value": "unsure",
          "label": "Not sure"
        }
      ]
    },
    {
      "id": "battery_history",
      "text": "Has the battery ever been replaced?",
      "type": "single_choice",
      "priority": 40,
      "targets": [
        "battery_wear"
      ],
      "visible_if": [
        "ans.primary_symptoms",
        "contains_any",
        [
          "battery_drain",
          "shutdowns",
          "not_charging",
          "overheating"
        ]
      ],
      "options": [
        {
          "value": "original",
          "label": "No, it's the original battery"
        },
        {
          "value": "replaced_recent",
          "label": "Yes, within the last year"
        },
        {
          "value": "replaced_old",
          "label": "Yes, more than a year ago"
        },
        {
          "value": "unsure",
          "label": "Not sure"
        }
      ]
    },
    {
      "id": "charging_behavior",
      "text": "What happens when you plug in a charger?",
      "type": "single_choice",
      "priority": 70,
      "targets": [
        "charging_path",
        "battery_wear"
      ],
      "visible_if": [
        "ans.primary_symptoms",
        "contains",
        "not_charging"
      ],
      "options": [
        {
          "value": "no_response",
          "label": "Nothing - no charging indicator"
        },
        {
          "value": "intermittent",
          "label": "Charges only if the cable is held at an angle, or keeps connecting/disconnecting"
        },
        {
          "value": "slow",
          "label": "Charges, but much more slowly than before"
        },
        {
          "value": "stops_partway",
          "label": "Starts charging then stops"
        },
        {
          "value": "unsure",
          "label": "Not sure"
        }
      ]
    },
    {
      "id": "charging_other_cable",
      "text": "Have you tried a different cable and charger that work with another phone?",
      "type": "single_choice",
      "priority": 65,
      "targets": [
        "charging_path"
      ],
      "visible_if": [
        "ans.primary_symptoms",
        "contains",
        "not_charging"
      ],
      "options": [
        {
          "value": "same_problem",
          "label": "Yes - same problem"
        },
        {
          "value": "works_fine",
          "label": "Yes - the other cable/charger works"
        },
        {
          "value": "not_tried",
          "label": "Not tried"
        }
      ]
    },
    {
      "id": "wireless_charging",
      "text": "Does wireless charging work?",
      "type": "single_choice",
      "priority": 45,
      "targets": [
        "charging_path",
        "battery_wear"
      ],
      "visible_if": {
        "all": [
          [
            "ans.primary_symptoms",
            "contains",
            "not_charging"
          ],
          [
            "ans.charging_behavior",
            "in",
            [
              "no_response",
              "intermittent",
              "stops_partway"
            ]
          ]
        ]
      },
      "options": [
        {
          "value": "works",
          "label": "Yes, wireless charging works"
        },
        {
          "value": "doesnt_work",
          "label": "No, it doesn't work either"
        },
        {
          "value": "not_available",
          "label": "Not supported / not tried"
        }
      ]
    },
    {
      "id": "port_debris",
      "text": "Shine a light into the charging port. Do you see lint, debris, corrosion or bent pins?",
      "type": "single_choice",
      "priority": 40,
      "targets": [
        "charging_path",
        "liquid_damage"
      ],
      "visible_if": [
        "ans.primary_symptoms",
        "contains",
        "not_charging"
      ],
      "options": [
        {
          "value": "debris",
          "label": "Lint or debris"
        },
        {
          "value": "corrosion",
          "label": "Green/white residue or corrosion"
        },
        {
          "value": "damage",
          "label": "Bent or loose parts"
        },
        {
          "value": "clean",
          "label": "Looks clean"
        },
        {
          "value": "unsure",
          "label": "Can't tell"
        }
