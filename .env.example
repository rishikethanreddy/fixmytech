# FixMyTech configuration. Copy to .env and adjust. Never commit .env.
# Every variable is optional; defaults are shown.

# --- Backend -----------------------------------------------------------------
FIXMYTECH_ENV=development                 # development | production | test
FIXMYTECH_DATABASE_URL=sqlite:///./var/fixmytech.db
FIXMYTECH_RETENTION_DAYS=30               # reports the customer chose to keep
FIXMYTECH_UNSAVED_RETENTION_HOURS=24      # all other reports
FIXMYTECH_RATE_LIMIT_PER_MINUTE=240       # per client IP, /api only
FIXMYTECH_VALUATION_LIMIT_PER_HOUR=20     # FlipValue calls per session
FIXMYTECH_MAX_BODY_BYTES=262144
FIXMYTECH_CORS_ORIGINS=                   # comma-separated; empty = same-origin only
FIXMYTECH_TRUST_PROXY_HEADERS=false       # true only behind a trusted reverse proxy
FIXMYTECH_MARKETS=IN:INR,US:USD          # supported markets (REGION:CURRENCY); no currency conversion is done
FIXMYTECH_DEFAULT_REGION=IN
FIXMYTECH_AGENT_URL=http://127.0.0.1:8765 # where the browser looks for the local agent
FIXMYTECH_LOG_FORMAT=text                 # text | json
FIXMYTECH_FRONTEND_DIR=                   # only needed when the package is installed outside the repo (Docker)

# --- Repair price intelligence (see docs/PRICING_SOURCES.md) -------------------
FIXMYTECH_PRICING_DIR=var/pricing         # dataset.json + ingestion reports, written by `python -m fixmytech.pricing.ingest`
FIXMYTECH_PRICING_CONTACT=                # contact address sent in the ingestion User-Agent (be a polite crawler)
# Source ids approved for display after reviewing each source's terms. Unset = all (development only);
# REQUIRED in production (may be empty). Example: samsung_in_parts,samsung_in_labour
FIXMYTECH_PRICING_ALLOWED_SOURCES=
FIXMYTECH_PRICING_DEMO=false              # DEMO generic ranges for development; refused in production
FIXMYTECH_PRICING_FRESH_DAYS=30
FIXMYTECH_PRICING_STALE_DAYS=90

# --- Optional ML (unvalidated; see docs/DATA_AND_MODEL_CARD.md) ---------------
FIXMYTECH_ML_ENABLED=false
FIXMYTECH_ML_MODEL_DIR=

# --- FlipValue integration ----------------------------------------------------
# disabled: no calls. mock: local MOCK server (development only, refused in production).
# live: the partner's real API (https required except for localhost).
FLIPVALUE_MODE=disabled
FLIPVALUE_BASE_URL=                       # e.g. https://api.flipvalue.example   (mock: http://127.0.0.1:8090)
FLIPVALUE_API_KEY=                        # secret: obtain from the FlipValue maintainer
FLIPVALUE_TIMEOUT_S=8
FLIPVALUE_MAX_RETRIES=2
FLIPVALUE_API_VERSION=1
# The API key can also be saved from the Settings page (stored server-side, not encrypted at rest):
FIXMYTECH_PARTNER_CONFIG_PATH=var/partner_service.json
FIXMYTECH_ADMIN_TOKEN=                    # required in production to use the Settings page for the key
FIXMYTECH_ALLOW_MOCK_VALUATION=false      # development only: let the MOCK FlipValue answer (never in production)

# --- Mock FlipValue server (development only) ---------------------------------
MOCK_FLIPVALUE_API_KEY=mock-dev-key
MOCK_FLIPVALUE_PORT=8090

# --- Local agent (runs on the customer's computer) -----------------------------
FIXMYTECH_WEB_URL=http://127.0.0.1:8000   # the web app allowed to use the agent (match --port of the server)
FIXMYTECH_AGENT_PORT=8765
FIXMYTECH_ADB_PATH=                       # optional explicit path to adb.exe
FIXMYTECH_AGENT_EXTRA_ORIGINS=            # extra allowed web origins, comma-separated
